{
  "name": "ollim-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",

    "start:dev": "BRANCH=dev DOMAIN_BASE=millo-ollim.com DOMAIN_PREFIX=dev expo start",
    "start:staging": "BRANCH=staging DOMAIN_BASE=millo-ollim.com DOMAIN_PREFIX=dev expo start",
    "start:prod": "BRANCH=main DOMAIN_BASE=millo-ollim.com DOMAIN_PREFIX=app expo start",

    "build:dev": "eas build --profile development --platform all",
    "build:staging": "eas build --profile preview --platform all",
    "build:prod": "eas build --profile production --platform all",

    "setup:ci": "npm ci",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "expo": "~53.0.6",
    "expo-build-properties": "^0.14.6",
    "expo-constants": "^17.1.5",
    "expo-secure-store": "^14.2.3",
    "expo-status-bar": "~2.2.3",
    "expo-web-browser": "^14.1.6",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-config": "^1.5.5",
    "react-native-webview": "^13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  },
  "private": true
}
