{
  "cli": {
    "version": ">= 3.13.3"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "BRANCH": "dev",
        "DOMAIN_BASE": "millo-ollim.com",
        "DOMAIN_PREFIX": "dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "BRANCH": "staging",
        "DOMAIN_BASE": "millo-ollim.com",
        "DOMAIN_PREFIX": "dev"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "BRANCH": "main",
        "DOMAIN_BASE": "millo-ollim.com",
        "DOMAIN_PREFIX": "app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "your-apple-id@example.com",
        "ascAppId": "your-app-store-connect-app-id",
        "appleTeamId": "your-apple-team-id"
      },
      "android": {
        "serviceAccountKeyPath": "path/to/service-account.json",
        "track": "production"
      }
    }
  }
}